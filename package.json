{
  "name": "ai-hologram-assistant",
  "version": "0.1.0",
  "description": "AI Hologram Assistant — your personal AI companion desktop app",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"VITE,ELECTRON\" -c \"cyan,yellow\" \"vite\" \"npm run electron:dev\"",
    "electron:dev": "tsc -p tsconfig.node.json && wait-on tcp:127.0.0.1:5173 && electron .",
    "build": "vite build && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "openai": "^7.19.0",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.167.1"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.167.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^31.3.1",
    "electron-builder": "^25.0.5",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.ai-hologram.assistant",
    "productName": "AI Hologram Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    }
  }
}
